<span id="cb7-17">    <span class="co" style="color: #5E5E5E;
background-color: null;
font-style: inherit;">#Y se añade al historial para usarlo en la siguiente vuelta</span></span>
<span id="cb7-18">    historial_para_ma.append(siguiente_pred)</span>
<span id="cb7-19"></span></code></pre></div></div>
